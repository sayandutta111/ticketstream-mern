# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/ticket_management
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/ticket_management
MONGODB_URI=mongodb://127.0.0.1:27017/ticket_management

# Processing Performance Tweaks
BATCH_SIZE=5000

